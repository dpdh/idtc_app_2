# Select a default provider: openai, gemini, or compatible
TWINI_PROVIDER=openai

# OpenAI Platform API (ChatGPT is a separate consumer product)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Any provider exposing an OpenAI-compatible Chat Completions endpoint
COMPATIBLE_PROVIDER_NAME=OpenAI-compatible
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=
COMPATIBLE_MODEL=

# Server controls
PORT=4174
HOST=127.0.0.1
TWINI_RATE_LIMIT_PER_MINUTE=20
# For Capacitor/remote frontends, list exact HTTPS origins separated by commas.
TWINI_ALLOWED_ORIGINS=

# PostgreSQL user management. Leave DATABASE_URL empty for localStorage mode.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10
PUBLIC_REGISTRATION=true
# Generate a long random token; needed only to bootstrap the first PostgreSQL Super Admin.
BOOTSTRAP_ADMIN_TOKEN=
# Use None for HTTPS Capacitor origins on a separate API host. Production cookies require HTTPS.
SESSION_COOKIE_SAMESITE=Lax
