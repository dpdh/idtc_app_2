{
  "name": "idtc-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "IDTC Mobile - Indonesia Digital Twin Community",
  "type": "module",
  "scripts": {
    "cap:init": "cap init IDTC Mobile idtc.mobile --web-dir .",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync",
    "android:open": "cap open android",
    "android:run": "cap run android",
    "android:build": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "ios:open": "cap open ios",
    "ios:run": "cap run ios"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@capacitor/android": "^7.4.0",
    "@capacitor/ios": "^7.4.0"
  }
}
